# 应用配置示例（复制为 .env 使用，绝不要提交真实 .env）
# 说明：以下所有外部服务字段均可留空，留空时后端自动降级为内置 mock/本地兜底。

# ---------- 基础 ----------
APP_NAME=自媒体 AI 工作台
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- 数据访问（async，Alembic 迁移共用） ----------
DATABASE_URL=postgresql+asyncpg://zmt:zmt@localhost:5432/zmt

# ---------- 队列 ----------
REDIS_URL=redis://localhost:6379/0

# ---------- LLM（OpenAI 兼容，默认 DeepSeek；留空走内置 mock） ----------
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ---------- ASR 转写 ----------
# 优先级：ASR_ENDPOINT > ASR_OPENAI_BASE_URL（faster-whisper）> 腾讯云云 API > 内置 mock
ASR_ENDPOINT=
# 宿主机的 meeting-minutes-stt 是 OpenAI 兼容 faster-whisper 服务，示例：
# ASR_OPENAI_BASE_URL=http://127.0.0.1:8010/v1
# ASR_OPENAI_MODEL=faster-whisper-base
# ASR_OPENAI_API_KEY=local
ASR_OPENAI_BASE_URL=
ASR_OPENAI_MODEL=
ASR_OPENAI_API_KEY=

# ---------- TTS 口播合成 ----------
# 优先级：TTS_ENDPOINT > TTS_EDGE_VOICE（edge-tts）> 腾讯云云 API > 禁用（由前端上传口播音频）
TTS_ENDPOINT=
TTS_VOICE=default
# edge-tts：voice 填常用中文音色即启用，如 zh-CN-XiaoxiaoNeural / zh-CN-YunxiNeural
TTS_EDGE_VOICE=
TTS_EDGE_RATE=+0%
TTS_EDGE_VOLUME=+0%

# ---------- 腾讯云云 API（ASR 录音文件识别 + TTS 语音合成） ----------
# 留空则自动降级：ASR 用 mock 占位词，TTS 关闭
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-guangzhou
# 识别引擎：16k_zh（中文通用）/ 8k_zh（电话音质）
TENCENT_ASR_ENGINE=16k_zh
# 合成音色（101001 智瑜女声）
TENCENT_TTS_VOICE_TYPE=101001
TENCENT_TTS_SPEED=0
TENCENT_TTS_VOLUME=0
TENCENT_TTS_SAMPLE_RATE=16000

# ---------- 腾讯云 COS 对象存储（留空走 LOCAL_MEDIA_DIR 本地磁盘兜底） ----------
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=zmt-workbench
COS_REGION=ap-guangzhou

# ---------- 抖音数据源（P0 授权验证后填写） ----------
DOUYIN_ACCESS_TOKEN=

# ---------- 本地媒体目录（无 COS 时的兜底存储根目录） ----------
LOCAL_MEDIA_DIR=media