# 应用配置示例（复制为 .env 使用，绝不要提交真实 .env）
# 说明：以下所有外部服务字段均可留空，留空时后端自动降级为内置 mock/本地兜底。

# ---------- 基础 ----------
APP_NAME=自媒体 AI 工作台
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- 数据访问（async，Alembic 迁移共用） ----------
DATABASE_URL=postgresql+asyncpg://zmt:zmt@localhost:5432/zmt

# ---------- 队列 ----------
REDIS_URL=redis://localhost:6379/0

# ---------- LLM（OpenAI 兼容，默认 DeepSeek；留空走内置 mock） ----------
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ---------- ASR 转写（FunASR 本地服务；留空走内置 mock 占位词） ----------
ASR_ENDPOINT=

# ---------- TTS 口播合成（占位，留空禁用） ----------
TTS_ENDPOINT=
TTS_VOICE=default

# ---------- 腾讯云 COS 对象存储（留空走 LOCAL_MEDIA_DIR 本地磁盘兜底） ----------
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=zmt-workbench
COS_REGION=ap-guangzhou

# ---------- 抖音数据源（P0 授权验证后填写） ----------
DOUYIN_ACCESS_TOKEN=

# ---------- 本地媒体目录（无 COS 时的兜底存储根目录） ----------
LOCAL_MEDIA_DIR=media