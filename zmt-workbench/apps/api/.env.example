# 应用配置示例（复制为 .env 使用，绝不要提交真实 .env）
# 说明：以下所有外部服务字段均可留空，留空时后端自动降级为内置 mock/本地兜底。

# ---------- 基础 ----------
APP_NAME=自媒体 AI 工作台
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- 数据访问（async，Alembic 迁移共用） ----------
DATABASE_URL=postgresql+asyncpg://zmt:zmt@localhost:5432/zmt

# ---------- 队列 ----------
REDIS_URL=redis://localhost:6379/0

# ---------- LLM（OpenAI 兼容，默认 DeepSeek；留空走内置 mock） ----------
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ---------- ASR 转写 ----------
# 优先级：ASR_ENDPOINT > ASR_OPENAI_BASE_URL（OpenAI 兼容）> 腾讯云云 API > 内置 mock
ASR_ENDPOINT=
# 宿主机 speech-gateway（ASR 转发 + TTS 豆包）示例，Base 到 /v1 为止，Token 走网关鉴权：
# ASR_OPENAI_BASE_URL=http://127.0.0.1:8100/v1
# ASR_OPENAI_MODEL=whisper-1
# ASR_OPENAI_API_KEY=<speech-gateway 项目 token>
ASR_OPENAI_BASE_URL=
ASR_OPENAI_MODEL=
ASR_OPENAI_API_KEY=

# ---------- TTS 口播合成 ----------
# 优先级：TTS_ENDPOINT > TTS_OPENAI_BASE_URL（语音网关）> TTS_EDGE_VOICE > 腾讯云 > 禁用
TTS_ENDPOINT=
TTS_VOICE=default
# 语音网关（OpenAI 兼容 /audio/speech，直出 mp3 字节）
TTS_OPENAI_BASE_URL=
TTS_OPENAI_API_KEY=
# 音色（豆包 seed-icl 复刻音色，如 S_VOECyTHf2；不填用网关默认）
TTS_OPENAI_VOICE=
# 语速（豆包范围 -50~100，整数；不填用网关默认 12）
TTS_OPENAI_SPEED=
# edge-tts：voice 填常用中文音色即启用，如 zh-CN-XiaoxiaoNeural / zh-CN-YunxiNeural
TTS_EDGE_VOICE=
TTS_EDGE_RATE=+0%
TTS_EDGE_VOLUME=+0%

# ---------- 腾讯云云 API（ASR 录音文件识别 + TTS 语音合成） ----------
# 留空则自动降级：ASR 用 mock 占位词，TTS 关闭
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-guangzhou
# 识别引擎：16k_zh（中文通用）/ 8k_zh（电话音质）
TENCENT_ASR_ENGINE=16k_zh
# 合成音色（101001 智瑜女声）
TENCENT_TTS_VOICE_TYPE=101001
TENCENT_TTS_SPEED=0
TENCENT_TTS_VOLUME=0
TENCENT_TTS_SAMPLE_RATE=16000

# ---------- 腾讯云 COS 对象存储（留空走 LOCAL_MEDIA_DIR 本地磁盘兜底） ----------
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=zmt-workbench
COS_REGION=ap-guangzhou

# ---------- 抖音数据源（P0 授权验证后填写） ----------
DOUYIN_ACCESS_TOKEN=

# ---------- 本地媒体目录（无 COS 时的兜底存储根目录） ----------
# 容器内固定为 /data/media（compose 的 media 卷），保证各 worker 共享同一份文件
LOCAL_MEDIA_DIR=media

# ---------- Remotion 模板渲染（可选，默认关闭走 FFmpeg） ----------
# 开启条件：renderer 已安装依赖（apps/renderer/node_modules）且进程内可用 npx/node + Chromium
# 出片优先级：composition=remotion 且可用 → Remotion；否则自动回退 FFmpeg
REMOTION_ENABLED=false
REMOTION_DIR=apps/renderer
REMOTION_ENTRY=src/index.ts
REMOTION_COMPOSITION=VideoTemplate
REMOTION_TIMEOUT_SECONDS=900
# 容器内 Chromium 路径，例如 /usr/bin/chromium；留空由 Remotion 自行探测
REMOTION_BROWSER_EXECUTABLE=